FROM golang:1.26.4-alpine AS build

ENV CGO_ENABLED=0
ENV GOMAXPROCS=2
# Compile in temporary memory-backed directories instead of retaining large Go build layers.
RUN --mount=type=tmpfs,target=/go/pkg/mod \
  --mount=type=tmpfs,target=/root/.cache/go-build \
  --mount=type=tmpfs,target=/tmp \
  go install -p=2 github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z \
  && mkdir /licenses \
  && cp /go/pkg/mod/github.com/minio/minio@*/LICENSE /licenses/minio-LICENSE
RUN --mount=type=tmpfs,target=/go/pkg/mod \
  --mount=type=tmpfs,target=/root/.cache/go-build \
  --mount=type=tmpfs,target=/tmp \
  go install -p=2 github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z \
  && cp /go/pkg/mod/github.com/minio/mc@*/LICENSE /licenses/mc-LICENSE

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /go/bin/minio /go/bin/mc /usr/local/bin/
COPY --from=build /licenses /licenses
EXPOSE 9000 9001
ENTRYPOINT ["minio"]

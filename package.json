{
  "name": "credtrail",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:page-assets": "pnpm exec tsx scripts/build-page-assets.mjs",
    "check:page-assets": "pnpm build:page-assets && pnpm exec vitest run apps/api-worker/src/page-assets.test.ts",
    "build:design-tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "check:design-tokens": "pnpm build:design-tokens && git diff --exit-code -- apps/api-worker/src/ui/page-assets/content/generated/design-tokens.css",
    "build": "pnpm exec vite build",
    "check:node-runtime": "pnpm --filter @credtrail/api-worker build:node-runtime",
    "export:programmatic-openapi": "pnpm exec tsx scripts/export-programmatic-openapi.mjs",
    "export:ob3-openapi": "pnpm exec tsx scripts/export-ob3-openapi.mjs",
    "check:ob3-openapi": "pnpm exec tsx scripts/check-ob3-openapi.mjs",
    "db:migrate:postgres": "node packages/db/scripts/migrate-postgres.mjs",
    "dev": "pnpm exec vite dev --host 127.0.0.1 --port 8787",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "dev:reset": "node scripts/dev-reset.mjs && pnpm dev:seed",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:seed": "pnpm exec tsx scripts/seed-local-dev.ts",
    "dev:login-as": "node scripts/create-local-login-url.mjs",
    "dev:demo": "node scripts/run-local-demo.mjs",
    "benchmark:badge-images": "pnpm exec tsx apps/api-worker/src/devtools/run-badge-image-model-benchmark.ts",
    "preview": "pnpm build && pnpm exec vite preview --host 127.0.0.1 --port 8787",
    "test:e2e": "pnpm exec playwright test --config playwright.config.mjs --project chromium",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prelint": "pnpm build:page-assets",
    "lint": "node scripts/run-oxlint.mjs --deny-warnings",
    "prelint:fix": "pnpm build:page-assets",
    "lint:fix": "node scripts/run-oxlint.mjs --fix --fix-suggestions --deny-warnings",
    "format": "pnpm exec oxfmt \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\" \"vite.config.mts\" \"vitest.config.ts\"",
    "format:check": "pnpm exec oxfmt --check \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\" \"vite.config.mts\" \"vitest.config.ts\"",
    "pretypecheck": "pnpm build:page-assets",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build:page-assets",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "pnpm check:design-tokens && pnpm check:page-assets && pnpm check:ob3-openapi && pnpm check:node-runtime && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:scripts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261006.1",
    "@digitalbazaar/data-integrity": "2.5.0",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "1.3.0",
    "@playwright/test": "^1.63.0",
    "@types/jsonld": "^1.5.15",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.0",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "3.5.13",
    "jsonld-signatures": "11.6.0",
    "mailparser": "3.9.31",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "rolldown": "1.2.12",
    "smtp-server": "3.19.15",
    "style-dictionary": "^5.5.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "4.147.0"
  }
}

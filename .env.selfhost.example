# Copy to .env.selfhost and fill in your database and private bucket settings.
# Managed Postgres: use your provider's connection URL with certificate-verified TLS.
# Optional local Postgres: postgres://credtrail:credtrail@postgres:5432/credtrail
# Add docker-compose.selfhost-postgres.yml to the Compose command for local Postgres.
DATABASE_URL=

# AWS S3: use the bucket's region and leave S3_ENDPOINT empty.
# Cloudflare R2: use S3_REGION=auto and the S3 API endpoint from your dashboard.
# Example R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials; leave empty for R2.
AWS_SESSION_TOKEN=

# Optional outbound email. Use smtp with your mail service, ses with AWS, or none.
EMAIL_PROVIDER=none
TRANSACTIONAL_EMAIL_FROM_ADDRESS=
TRANSACTIONAL_EMAIL_FROM_NAME=CredTrail
TRANSACTIONAL_EMAIL_REPLY_TO=
# Optional issuer look for every transactional email: hex colors and an absolute http(s) logo URL.
# Invalid values fall back to the built-in CredTrail palette.
EMAIL_THEME_HEADER_COLOR=
EMAIL_THEME_ACCENT_COLOR=
EMAIL_THEME_HIGHLIGHT_COLOR=
EMAIL_LOGO_URL=
# Copies every tenant's badge issuance; never copies sign-in/reset/invitation links.
# Leave unset unless these recipients are authorized to receive learner information.
ISSUANCE_EMAIL_BCC=
SMTP_HOST=
# Empty chooses 587 for starttls, 465 for tls. TLS and valid certificates are required.
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_AUTH=login
SMTP_USERNAME=
# Prefer SMTP_PASSWORD_FILE with a Docker secret; set exactly one password source.
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_TLS_CA_FILE=
# SES uses the existing AWS credential variables, not SMTP credentials.
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=

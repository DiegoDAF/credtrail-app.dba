# Copy to .env.selfhost and fill in your database and private bucket settings.
# Managed Postgres: use your provider's connection URL with certificate-verified TLS.
# Optional local Postgres: postgres://credtrail:credtrail@postgres:5432/credtrail
# Add docker-compose.selfhost-postgres.yml to the Compose command for local Postgres.
DATABASE_URL=

# AWS S3: use the bucket's region and leave S3_ENDPOINT empty.
# Cloudflare R2: use S3_REGION=auto and the S3 API endpoint from your dashboard.
# Example R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials; leave empty for R2.
AWS_SESSION_TOKEN=
